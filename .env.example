# Copied to .env by `pnpm run setup`. Empty secrets are generated automatically.
# Never commit .env (PLAN §20.1).

NODE_ENV=development

# --- Database (embedded PostgreSQL 16 in development, PLAN §9.2) ---
PG_PORT=54329
PG_DATABASE=wusool
PG_PASSWORD=
# Superuser connection, used for migrations and seeding. Filled in by setup.
DATABASE_ADMIN_URL=
# Passwords for the two login roles created by the migrations (generated).
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=
# Request-serving role, subject to Row Level Security. Filled in by setup.
DATABASE_URL=
# Sign-in flows and background jobs; bypasses RLS. Filled in by setup.
DATABASE_SYSTEM_URL=

# --- API ---
API_PORT=3000
# Comma-separated extra origins; Capacitor origins are always allowed.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public base URL of the API (used for signed photo links).
PUBLIC_API_URL=http://localhost:3000/v1

# --- Web (read by Vite; only VITE_* reaches the browser) ---
VITE_API_URL=http://localhost:3000/v1

# --- Auth secrets (generated) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=
PHOTO_URL_SECRET=

# --- Web Push / VAPID (generated) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@wusool.local

# --- Email (local mail catcher in development: http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Tammeni <no-reply@wusool.local>"
MAIL_UI_PORT=8025

# --- Backups (pnpm --filter @wusool/api db:backup; key generated, keep a copy OFF the server) ---
BACKUP_KEY=
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- Hardening ---
# Number of reverse proxies in front of the API (1 behind Caddy in production).
TRUST_PROXY_HOPS=0

# --- Monitoring (optional; Sentry stays off unless set, PLAN §20.3) ---
SENTRY_DSN=

# --- Native app push (phase 6, optional; docs/RELEASE.md) ---
# Android: the Firebase service-account JSON file, base64-encoded on one line.
FCM_SERVICE_ACCOUNT_BASE64=
# iOS: the APNs .p8 key base64-encoded, its Key ID, and the Apple Team ID.
APNS_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.tammeni.app
# production (TestFlight / App Store) or sandbox (Xcode builds); defaults by NODE_ENV.
APNS_ENV=
