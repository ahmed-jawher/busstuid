# Copy to keystore.properties (git-ignored) on the machine that builds releases.
#
# Create the key once, and never lose it — Google Play ties the app to it:
#   keytool -genkeypair -v -keystore tammene-upload.jks -alias tammene \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then build the file Play accepts:
#   VITE_API_URL=https://tammene.com/v1 pnpm --filter @wusool/web native:sync
#   cd apps/web/android && ./gradlew bundleRelease
#   → app/build/outputs/bundle/release/app-release.aab
storeFile=/absolute/path/to/tammene-upload.jks
storePassword=
keyAlias=tammene
keyPassword=
