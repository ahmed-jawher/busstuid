{
  "name": "@wusool/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "test": "prisma generate && vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc --noEmit",
    "openapi:emit": "nest build && node dist/openapi.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:roles": "node scripts/with-env.mjs tsx src/ops/cli.ts roles",
    "db:rollback": "node scripts/with-env.mjs tsx scripts/rollback.ts",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "loadtest": "vitest run --config vitest.load.config.ts",
    "db:backup": "node scripts/with-env.mjs tsx src/ops/cli.ts backup",
    "db:restore": "node scripts/with-env.mjs tsx src/ops/cli.ts restore"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "10.75.1",
    "@wusool/shared": "workspace:*",
    "argon2": "0.45.1",
    "helmet": "8.3.0",
    "libphonenumber-js": "1.13.13",
    "nestjs-pino": "5.2.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.0",
    "pg-boss": "^10.4.2",
    "pino": "10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "^5.0.3",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.6",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "3.2.7",
    "@wusool/config": "workspace:*",
    "@wusool/dev-stack": "workspace:*",
    "chokidar": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "7.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
