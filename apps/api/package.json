    "@wusool/shared": "workspace:*",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.5",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@wusool/config": "workspace:*",
    "@wusool/dev-stack": "workspace:*",
    "chokidar": "^5.0.0",
